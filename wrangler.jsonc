{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoardingcleanupfinder",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // keep_vars: a deploy must never wipe variables set in the dashboard (it did once — it
  // dropped TURNSTILE_SITE_KEY and reset FROM_EMAIL). Public, non-secret values live here;
  // secrets only in the dashboard.
  "keep_vars": true,
  "vars": {
    "SITE_URL": "https://hoardingcleanupfinder.com",
    "SITE_NAME": "Hoarding Cleanup Finder",
    "FROM_EMAIL": "onboarding@resend.dev",
    "FEATURED_MONTHLY_USD": "49",
    "FEATURED_ANNUAL_USD": "399",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEz-zMBix5CVEIyu",
    "INDEXNOW_KEY": "4f2a9c1e7b3d8e6a5c0f1b2d3e4a5c6b"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "hcf-db", "database_id": "086a07e7-896f-44d2-9335-85d0ed5725d9", "migrations_dir": "migrations" }
  ]
}

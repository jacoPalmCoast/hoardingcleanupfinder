{
  "name": "hoardingcleanupfinder",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "deploy:ci": "wrangler deploy",
    "db:seed:local": "wrangler d1 execute hcf-db --local --file data/seed.sql",
    "db:seed:remote": "wrangler d1 execute hcf-db --remote --file data/seed.sql --yes",
    "db:migrate:local": "wrangler d1 migrations apply hcf-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply hcf-db --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "astro": "^7.3.2",
    "stripe": "^22.6.2",
    "wrangler": "^4.131.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260911.1",
    "typescript": "^6.0.3"
  }
}

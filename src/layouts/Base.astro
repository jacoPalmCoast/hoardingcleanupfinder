---
import '../styles/global.css';
import { env } from '../lib/env';
import { SERVICES } from '../data/services';
import { safeJson } from '../lib/util';
import { orgSchema, websiteSchema } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  jsonld?: unknown;
  ogImage?: string;
}
const { title, description, canonical, noindex = false, jsonld, ogImage } = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname, env.SITE_URL).toString();
const ogImageUrl = new URL(ogImage ?? '/og-default.png', env.SITE_URL).toString();
const fullTitle = title.includes(env.SITE_NAME) ? title : `${title} | ${env.SITE_NAME}`;
// One @graph per page: site-wide Organization + WebSite, then whatever the page adds
// (a single node or an array of nodes).
const graph = [orgSchema(), websiteSchema(), ...(Array.isArray(jsonld) ? jsonld : jsonld ? [jsonld] : [])].filter(Boolean).map((n: any) => {
  if (n && typeof n === 'object' && '@context' in n) { const { ['@context']: _c, ...rest } = n; return rest; }
  return n;
});
const ld = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&display=swap"
    />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={env.SITE_NAME} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#0f6d6a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={safeJson(ld)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">Hoarding Cleanup <span>Finder</span></a>
        <nav class="main" aria-label="Main">
          <a href="/guides">Guides</a>
          <a href="/state">States</a>
          <a href="/add-listing">Add a company</a>
          <a class="login" href="/account">Advertiser Login</a>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap cols">
        <div>
          <strong>Hoarding Cleanup Finder</strong>
          <p class="small">A directory of hoarding, biohazard, unattended death and estate cleanup companies across the United States. Listings are free. Companies can <a href="/add-listing">add</a> or <a href="/guides/claim-your-listing">claim</a> a listing.</p>
        </div>
        <div>
          <strong>Services</strong>
          <ul style="list-style:none;padding:0;margin:6px 0 0">
            {SERVICES.map((s) => <li><a href={`/services/${s.slug}`}>{s.name}</a></li>)}
          </ul>
        </div>
        <div>
          <strong>Site</strong>
          <ul style="list-style:none;padding:0;margin:6px 0 0">
            <li><a href="/guides">Guides</a></li>
            <li><a href="/account">Advertiser Login</a></li>
            <li><a href="/about">About and listing policy</a></li>
            <li><a href="/support">Contact / support</a></li>
            <li><a href="/feedback">Send feedback</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/terms">Terms of Service</a></li>
            <li><a href="/refunds">Cancellation &amp; refunds</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap small" style="margin-top:20px">If you are in immediate danger or someone needs urgent medical help, call 911. Information on this site is general and not medical or legal advice.</div>
    </footer>
    <a class="fb-fab" href="/feedback" aria-label="Send feedback">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      <span>Feedback</span>
    </a>
    <script is:inline>
      // Carry the current page path into the feedback form so admin sees where an issue was seen.
      (function () {
        var fab = document.querySelector('.fb-fab');
        if (fab) fab.setAttribute('href', '/feedback?from=' + encodeURIComponent(location.pathname));
      })();
      // Insert a "Back" control just under the breadcrumbs on every page that has them.
      // Goes to the previous page when the visitor arrived from within the site; otherwise
      // falls back to the parent breadcrumb (or home) so a direct/search landing still works.
      (function () {
        var crumbs = document.querySelector('main .crumbs');
        if (!crumbs || document.querySelector('.backlink')) return;
        var links = crumbs.querySelectorAll('a');
        var parent = links.length ? links[links.length - 1].getAttribute('href') : '/';
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'backlink';
        btn.setAttribute('aria-label', 'Go back to the previous page');
        btn.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Back';
        btn.addEventListener('click', function () {
          var sameSite = document.referrer && document.referrer.indexOf(location.origin + '/') === 0;
          if (sameSite && history.length > 1) history.back();
          else location.href = parent || '/';
        });
        crumbs.insertAdjacentElement('afterend', btn);
      })();
    </script>
    {env.WEB_ANALYTICS_TOKEN && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${env.WEB_ANALYTICS_TOKEN}"}`}></script>
    )}
  </body>
</html>

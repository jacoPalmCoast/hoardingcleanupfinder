---
import Base from '../../../layouts/Base.astro';
import ListingCard from '../../../components/ListingCard.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import Faq from '../../../components/Faq.astro';
import QuickAnswer from '../../../components/QuickAnswer.astro';
import CostTable from '../../../components/CostTable.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import LocalContext from '../../../components/LocalContext.astro';
import { getCity, listingsForCity, countByCityService, citiesForState, MIN_LISTINGS_FOR_PAGE } from '../../../lib/db';
import { trackImpressions, waitCtx } from '../../../lib/events';
import { STATES, isState } from '../../../data/states';
import { SERVICES } from '../../../data/services';
import { STATE_NOTES } from '../../../data/stateNotes';
import { intentsFor } from '../../../data/intents';
import { GUIDES } from '../../../data/guides';
import { parseAttrs } from '../../../data/attrs';
import { faqSchema, webPageSchema, breadcrumbSchema } from '../../../lib/seo';
import { env } from '../../../lib/env';

const st = (Astro.params.st ?? '').toUpperCase();
const citySlug = (Astro.params.city ?? '').toLowerCase();
if (Astro.params.st !== st.toLowerCase() || Astro.params.city !== citySlug) return Astro.redirect(`/${st.toLowerCase()}/${citySlug}${Astro.params.service ? '/' + Astro.params.service : ''}`, 301);
if (!isState(st)) return new Response(null, { status: 404 });
const city = await getCity(st, citySlug);
if (!city) return new Response(null, { status: 404 });
const listings = await listingsForCity(st, citySlug);
if (listings.length < MIN_LISTINGS_FOR_PAGE) return new Response(null, { status: 404 });
trackImpressions(listings.map((l) => l.id), Astro.request, 'city', waitCtx(Astro.locals));
const [counts, stateCities] = await Promise.all([countByCityService(st, citySlug), citiesForState(st)]);
const nearby = stateCities.filter((c) => c.slug !== citySlug).slice(0, 8);
const servicesHere = SERVICES.filter((s) => (counts[s.slug] ?? 0) >= MIN_LISTINGS_FOR_PAGE);
const guideLinks = [
  { href: '/guides/hoarding-cleanup-cost', label: 'What hoarding cleanup costs' },
  { href: '/guides/how-to-choose-a-hoarding-cleanup-company', label: 'How to choose a company' },
  { href: '/guides/hoarding-and-insurance', label: 'Does insurance cover it?' },
].filter((g) => GUIDES.some((x) => `/guides/${x.slug}` === g.href));
const stateName = STATES[st];
const title = `Hoarding cleanup in ${city.name}, ${st}`;
const url = `${env.SITE_URL}/${st.toLowerCase()}/${citySlug}`;
const verified = listings.filter((l) => l.is_verified === 1).length;
const hours24 = listings.filter((l) => parseAttrs(l.attrs).hours24).length;
const faq = intentsFor('metro', undefined, { city: city.name, state: st, stateName, n: listings.length, verified, hours24, stateNote: STATE_NOTES[st] });
const description = `${listings.length} hoarding, biohazard and estate cleanup companies in ${city.name}, ${stateName}${verified ? `, ${verified} verified` : ''}. Phone numbers, services, typical costs and free quote requests.`;
const jsonld = [
  webPageSchema(url, `${title} — ${listings.length} companies`, description, { speakable: true }),
  breadcrumbSchema([{ name: 'Home', url: env.SITE_URL }, { name: stateName, url: `${env.SITE_URL}/state/${st.toLowerCase()}` }, { name: city.name }]),
  {
    '@type': 'ItemList',
    name: `${title} — ${listings.length} companies`,
    numberOfItems: listings.length,
    itemListElement: listings.slice(0, 20).map((l, i) => ({ '@type': 'ListItem', position: i + 1, url: `${env.SITE_URL}/company/${l.slug}`, name: l.name })),
  },
  faqSchema(faq),
];
---
<Base title={`${title} — ${listings.length} companies`} description={description} jsonld={jsonld}>
  <p class="crumbs"><a href="/">Home</a> › <a href={`/state/${st.toLowerCase()}`}>{stateName}</a> › {city.name}</p>
  <h1>{title}</h1>
  <p class="lede">{city.intro ?? `${listings.length} companies serve ${city.name} and nearby${verified ? `; ${verified} are verified` : ''}${hours24 ? ` and ${hours24} offer 24-hour response` : ''}. Call directly, or send one request and we will pass it to up to three of them.`}</p>

  <QuickAnswer>
    <p><strong>{listings.length} hoarding, biohazard and estate cleanup {listings.length === 1 ? 'company serves' : 'companies serve'} {city.name}, {st}</strong>{verified ? `, ${verified} verified` : ''}. Most jobs run <strong>$1,500–$5,000</strong> for a typical hoarded home; biohazard and unattended-death work is often billed to insurance. Get a written estimate after an on-site walk-through, and get a second one on anything over $3,000.</p>
  </QuickAnswer>

  <div class="badges">
    {servicesHere.map((s) => (
      <a class="badge" href={`/${st.toLowerCase()}/${citySlug}/${s.slug}`}>{s.name} ({counts[s.slug]})</a>
    ))}
  </div>
  <div class="two">
    <section>
      <h2 class="sr-head">Companies serving {city.name}</h2>
      <div class="grid">{listings.map((l) => <ListingCard l={l} showCity={false} source="city" />)}</div>
      <p class="small" style="margin-top:16px">Featured companies pay for placement and are labeled. Everyone else is ordered by verification and review count. <a href="/about">How listings work.</a></p>
      <Faq items={faq} heading={`Hoarding cleanup in ${city.name}: what to know`} />
    </section>
    <aside><QuoteForm city={city.name} state={st} heading={`Get quotes in ${city.name}`} /></aside>
  </div>

  {city.body ? <section class="prose local-body" set:html={city.body} /> : (
    <LocalContext city={city.name} state={st} stateName={stateName} n={listings.length} verified={verified} hours24={hours24} stateNote={STATE_NOTES[st] ?? ''} services={servicesHere.map((s) => s.slug)} />
  )}

  <section>
    <h2>What cleanup costs near {city.name}</h2>
    <CostTable place={`${city.name}, ${st}`} />
  </section>

  <RelatedLinks heading={`${stateName}: nearby cities`} links={nearby.map((c) => ({ href: `/${st.toLowerCase()}/${c.slug}`, label: `${c.name} (${c.listing_count})` }))} />
  <RelatedLinks heading="Read before you hire" links={guideLinks} />
</Base>

<style>
  .sr-head { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .local-body { max-width: 68ch; margin-top: 8px; }
</style>

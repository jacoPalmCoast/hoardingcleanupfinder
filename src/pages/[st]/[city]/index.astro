---
import Base from '../../../layouts/Base.astro';
import ListingCard from '../../../components/ListingCard.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import Faq from '../../../components/Faq.astro';
import { getCity, listingsForCity, countByCityService, MIN_LISTINGS_FOR_PAGE } from '../../../lib/db';
import { STATES, isState } from '../../../data/states';
import { SERVICES } from '../../../data/services';
import { STATE_NOTES } from '../../../data/stateNotes';
import { intentsFor } from '../../../data/intents';
import { parseAttrs } from '../../../data/attrs';
import { faqSchema, webPageSchema, breadcrumbSchema } from '../../../lib/seo';
import { env } from '../../../lib/env';

const st = (Astro.params.st ?? '').toUpperCase();
const citySlug = (Astro.params.city ?? '').toLowerCase();
if (Astro.params.st !== st.toLowerCase() || Astro.params.city !== citySlug) return Astro.redirect(`/${st.toLowerCase()}/${citySlug}${Astro.params.service ? '/' + Astro.params.service : ''}`, 301);
if (!isState(st)) return new Response(null, { status: 404 });
const city = await getCity(st, citySlug);
if (!city) return new Response(null, { status: 404 });
const listings = await listingsForCity(st, citySlug);
if (listings.length < MIN_LISTINGS_FOR_PAGE) return new Response(null, { status: 404 });
const counts = await countByCityService(st, citySlug);
const stateName = STATES[st];
const title = `Hoarding cleanup in ${city.name}, ${st}`;
const url = `${env.SITE_URL}/${st.toLowerCase()}/${citySlug}`;
const verified = listings.filter((l) => l.is_verified === 1).length;
const hours24 = listings.filter((l) => parseAttrs(l.attrs).hours24).length;
const faq = intentsFor('metro', undefined, { city: city.name, state: st, stateName, n: listings.length, verified, hours24, stateNote: STATE_NOTES[st] });
const description = `${listings.length} hoarding, biohazard and estate cleanup companies in ${city.name}, ${stateName}${verified ? `, ${verified} verified` : ''}. Phone numbers, services, typical costs and free quote requests.`;
const jsonld = [
  webPageSchema(url, `${title} — ${listings.length} companies`, description, { speakable: true }),
  breadcrumbSchema([{ name: 'Home', url: env.SITE_URL }, { name: stateName, url: `${env.SITE_URL}/state/${st.toLowerCase()}` }, { name: city.name }]),
  {
    '@type': 'ItemList',
    name: `${title} — ${listings.length} companies`,
    numberOfItems: listings.length,
    itemListElement: listings.slice(0, 20).map((l, i) => ({ '@type': 'ListItem', position: i + 1, url: `${env.SITE_URL}/company/${l.slug}`, name: l.name })),
  },
  faqSchema(faq),
];
---
<Base title={`${title} — ${listings.length} companies`} description={description} jsonld={jsonld}>
  <p class="crumbs"><a href="/">Home</a> › <a href={`/state/${st.toLowerCase()}`}>{stateName}</a> › {city.name}</p>
  <h1>{title}</h1>
  <p class="lede">{city.intro ?? `${listings.length} companies serve ${city.name} and nearby${verified ? `; ${verified} are verified` : ''}${hours24 ? ` and ${hours24} offer 24-hour response` : ''}. Call directly, or send one request and we will pass it to up to three of them.`}</p>
  <div class="badges">
    {SERVICES.filter((s) => (counts[s.slug] ?? 0) >= MIN_LISTINGS_FOR_PAGE).map((s) => (
      <a class="badge" href={`/${st.toLowerCase()}/${citySlug}/${s.slug}`}>{s.name} ({counts[s.slug]})</a>
    ))}
  </div>
  <div class="two">
    <section>
      <div class="grid">{listings.map((l) => <ListingCard l={l} showCity={false} />)}</div>
      <p class="small" style="margin-top:16px">Featured companies pay for placement and are labeled. Everyone else is ordered by verification and review count. <a href="/about">How listings work.</a></p>
      <Faq items={faq} heading={`Hoarding cleanup in ${city.name}: what to know`} />
    </section>
    <aside><QuoteForm city={city.name} state={st} heading={`Get quotes in ${city.name}`} /></aside>
  </div>
</Base>

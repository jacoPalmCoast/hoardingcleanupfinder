---
import Base from '../../../layouts/Base.astro';
import ListingCard from '../../../components/ListingCard.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import Faq from '../../../components/Faq.astro';
import { getCity, listingsForCity, MIN_LISTINGS_FOR_PAGE } from '../../../lib/db';
import { STATES, isState } from '../../../data/states';
import { SERVICE_BY_SLUG } from '../../../data/services';
import { STATE_NOTES } from '../../../data/stateNotes';
import { intentsFor } from '../../../data/intents';
import { parseAttrs } from '../../../data/attrs';
import { faqSchema, webPageSchema, breadcrumbSchema } from '../../../lib/seo';
import { env } from '../../../lib/env';

const st = (Astro.params.st ?? '').toUpperCase();
const citySlug = (Astro.params.city ?? '').toLowerCase();
if (Astro.params.st !== st.toLowerCase() || Astro.params.city !== citySlug) return Astro.redirect(`/${st.toLowerCase()}/${citySlug}${Astro.params.service ? '/' + Astro.params.service : ''}`, 301);
const svc = SERVICE_BY_SLUG[Astro.params.service ?? ''];
if (!isState(st) || !svc) return new Response(null, { status: 404 });
const city = await getCity(st, citySlug);
if (!city) return new Response(null, { status: 404 });
const listings = await listingsForCity(st, citySlug, svc.slug);
if (listings.length < MIN_LISTINGS_FOR_PAGE) return new Response(null, { status: 404 });
const stateName = STATES[st];
const title = `${svc.name} in ${city.name}, ${st}`;
const url = `${env.SITE_URL}/${st.toLowerCase()}/${citySlug}/${svc.slug}`;
const verified = listings.filter((l) => l.is_verified === 1).length;
const hours24 = listings.filter((l) => parseAttrs(l.attrs).hours24).length;
const faq = intentsFor('metro', svc.slug, { city: city.name, state: st, stateName, n: listings.length, verified, hours24, stateNote: STATE_NOTES[st], service: svc.slug });
const description = `${listings.length} ${svc.name.toLowerCase()} companies in ${city.name}, ${stateName}${verified ? `, ${verified} verified` : ''}. ${svc.description}`;
const jsonld = [
  webPageSchema(url, `${title} — ${listings.length} companies`, description, { speakable: true }),
  breadcrumbSchema([{ name: 'Home', url: env.SITE_URL }, { name: stateName, url: `${env.SITE_URL}/state/${st.toLowerCase()}` }, { name: city.name, url: `${env.SITE_URL}/${st.toLowerCase()}/${citySlug}` }, { name: svc.name }]),
  {
    '@type': 'ItemList',
    name: `${title} — ${listings.length} companies`,
    numberOfItems: listings.length,
    itemListElement: listings.slice(0, 20).map((l, i) => ({ '@type': 'ListItem', position: i + 1, url: `${env.SITE_URL}/company/${l.slug}`, name: l.name })),
  },
  faqSchema(faq),
];
---
<Base title={`${title} — ${listings.length} companies`} description={description} jsonld={jsonld}>
  <p class="crumbs"><a href="/">Home</a> › <a href={`/state/${st.toLowerCase()}`}>{stateName}</a> › <a href={`/${st.toLowerCase()}/${citySlug}`}>{city.name}</a> › {svc.name}</p>
  <h1>{title}</h1>
  <p class="lede">{svc.description} {listings.length} companies in {city.name} list this service{hours24 ? `; ${hours24} respond 24 hours a day` : ''}.</p>
  <div class="two">
    <section>
      <div class="grid">{listings.map((l) => <ListingCard l={l} showCity={false} />)}</div>
      <Faq items={faq} heading={`${svc.name} in ${city.name}: what to know`} />
    </section>
    <aside><QuoteForm city={city.name} state={st} heading={`Get ${svc.name.toLowerCase()} quotes`} /></aside>
  </div>
</Base>

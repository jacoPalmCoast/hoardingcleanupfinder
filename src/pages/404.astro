---
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
---
<Base title="Page not found" description="That page could not be found. Search for a hoarding, biohazard or estate cleanup company by city, state or ZIP." noindex>
  <span class="eyebrow">Error 404</span>
  <h1>That page isn't here <span class="accent">— let's find what you need</span></h1>
  <p class="lede">The link may be old or mistyped. Search by city, state or ZIP to find cleanup companies near you.</p>
  <SearchForm />
  <p class="small" style="margin-top:24px">
    Or head to the <a href="/">home page</a>, <a href="/state">browse companies by state</a>, read the <a href="/guides">guides</a>, or <a href="/add-listing">add your company</a>.
  </p>
</Base>

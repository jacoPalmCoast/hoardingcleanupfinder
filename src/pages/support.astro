---
import Base from '../layouts/Base.astro';
import { env } from '../lib/env';
const siteKey = env.TURNSTILE_SITE_KEY ?? '';
const msg = Astro.url.searchParams.get('msg');
---
<Base title="Support" description="Contact Hoarding Cleanup Finder for help with a listing or a question." noindex>
  <h1>Contact support</h1>
  {msg === 'received' && <div class="notice" role="status">Thanks — we got your message and will reply by email, usually within one business day.</div>}
  {msg === 'invalid' && <div class="notice error" role="alert">Please add a subject, a valid email, and a message of at least 10 characters.</div>}
  {msg === 'captcha' && <div class="notice error" role="alert">The spam check didn't pass. Reload the page and try again.</div>}
  {msg === 'rate-limited' && <div class="notice error" role="alert">That's a few too many messages in a short time. Please wait a little and try again.</div>}
  <p class="lede">Questions about your listing, billing, or anything else — send a note and a person will get back to you. If you run a company and want a correction or removal, you can also use the "report a correction" link on your listing.</p>
  <form action="/api/support" method="post" style="max-width:560px">
    <label for="email">Your email</label>
    <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" />
    <label for="subject">Subject</label>
    <input id="subject" name="subject" type="text" required maxlength="150" />
    <label for="message">How can we help?</label>
    <textarea id="message" name="message" required minlength="10" maxlength="4000" rows="6"></textarea>
    {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-size="flexible" style="margin-top:12px"></div>}
    <button class="btn" type="submit" style="margin-top:12px">Send message</button>
  </form>
  {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</Base>

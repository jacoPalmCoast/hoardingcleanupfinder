---
import Base from '../../layouts/Base.astro';
import { currentOwner } from '../../lib/services';
import { env } from '../../lib/env';
import { isLive } from '../../lib/db';
import { tsToDate } from '../../lib/util';
import type { Listing } from '../../lib/db';
const owner = await currentOwner(Astro.request);
const msg = Astro.url.searchParams.get('msg');
let listings: Listing[] = [];
let pending: { name: string; slug: string }[] = [];
if (owner) {
  listings = (await env.DB.prepare(`SELECT l.* FROM listings l JOIN owner_listings ol ON ol.listing_id = l.id WHERE ol.owner_id = ?1 ORDER BY l.name`).bind(owner.id).all<Listing>()).results;
  pending = (await env.DB.prepare(`SELECT l.name, l.slug FROM claims c JOIN listings l ON l.id = c.listing_id WHERE c.email = ?1 AND c.status = 'review'`).bind(owner.email).all<{ name: string; slug: string }>()).results;
}
const siteKey = env.TURNSTILE_SITE_KEY ?? '';
const step = Astro.url.searchParams.get('step');
const email = Astro.url.searchParams.get('email') ?? '';
---
<Base title="Company account" description="Manage your listing." noindex>
  {!owner ? (
    <>
      <h1>Company sign in</h1>
      <p class="lede">We email you a code. No password to remember.</p>
      {msg === 'wrong-code' && <div class="notice error" role="alert">Wrong or expired code.</div>}
      {msg === 'invalid' && <div class="notice error" role="alert">Check the email address and try again.</div>}
      {step !== 'code' ? (
        <form action="/api/account/login" method="post" style="max-width:420px">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required maxlength="254" />
          {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-size="flexible" style="margin-top:12px"></div>}
          <button class="btn" type="submit" style="margin-top:12px">Send code</button>
        </form>
      ) : (
        <form action="/api/account/verify" method="post" style="max-width:420px">
          <input type="hidden" name="email" value={email} />
          <p>Code sent to <strong>{email}</strong>.</p>
          <label for="code">6-digit code</label>
          <input id="code" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autocomplete="one-time-code" />
          <button class="btn" type="submit" style="margin-top:12px">Sign in</button>
        </form>
      )}
      <p class="small" style="margin-top:20px">Not listed yet? <a href="/add-listing">Add your company</a>. Listed but not claimed? Open your listing page and click "Claim this listing".</p>
      {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
    </>
  ) : (
    <>
      <h1>Your listings</h1>
      <div class="small">Signed in as {owner.email}. <form class="inline" action="/api/account/logout" method="post"><button type="submit" class="linkbtn">Sign out</button></form></div>
      {msg === 'claimed' && <div class="notice" role="status">Listing claimed. You can edit it below.</div>}
      {msg === 'claim-review' && <div class="notice" role="status">Code confirmed. Because the email is not on the company's website domain, a person will review the claim within one business day and email you.</div>}
      {msg === 'saved' && <div class="notice" role="status">Saved.</div>}
      {msg === 'featured' && <div class="notice" role="status">Payment received. Your listing is featured; it can take a minute to show.</div>}
      {pending.length > 0 && <div class="notice warn">Awaiting review: {pending.map((p) => p.name).join(', ')}</div>}
      {listings.length === 0 && pending.length === 0 && <p>No listings are attached to this email yet.</p>}
      <div class="grid">
        {listings.map((l) => (
          <div class="card">
            <div class="badges">{isLive(l) ? <span class="badge featured">Featured until {(tsToDate(l.featured_until)?.toLocaleDateString('en-US')) ?? '—'}</span> : <span class="badge">Free listing</span>}</div>
            <h3><a href={`/company/${l.slug}`}>{l.name}</a></h3>
            <div class="meta">{l.city}, {l.state}</div>
            {(isLive(l) || l.subscription_status) && (
              <p class="small" style="margin:8px 0 0">
                {l.plan_amount ? `${l.plan_interval === 'year' ? 'Annual' : 'Monthly'} plan · $${(l.plan_amount / 100).toLocaleString('en-US')}${l.plan_interval === 'year' ? '/yr' : '/mo'}` : 'Featured plan'}
                {l.subscription_status ? ` · ${l.subscription_status}` : ''}
                {l.featured_until ? ` · ${l.subscription_status === 'active' || l.subscription_status === 'trialing' ? 'renews' : 'ends'} ${(tsToDate(l.featured_until)?.toLocaleDateString('en-US')) ?? ''}` : ''}
              </p>
            )}
            <div class="actions">
              <a class="btn small" href={`/account/edit/${l.id}`}>Edit listing</a>
              {isLive(l) || l.stripe_customer_id ? <form action="/api/stripe/portal" method="post" style="display:inline"><button type="submit" class="btn small secondary">Manage billing</button></form> : <a class="btn small secondary" href={`/featured/${l.slug}`}>Get featured</a>}
            </div>
          </div>
        ))}
      </div>
    </>
  )}
</Base>

---
import Base from '../../layouts/Base.astro';
import { getListingBySlug } from '../../lib/db';
import { env } from '../../lib/env';
const l = await getListingBySlug(Astro.params.slug ?? '');
if (!l) return new Response(null, { status: 404 });
const siteKey = env.TURNSTILE_SITE_KEY ?? '';
const step = Astro.url.searchParams.get('step') ?? 'email';
const email = Astro.url.searchParams.get('email') ?? '';
const msg = Astro.url.searchParams.get('msg');
---
<Base title={`Claim ${l.name}`} description="Claim your free listing to manage details, photos and quote requests." noindex>
  <h1>Claim this listing</h1>
  <p class="lede"><strong>{l.name}</strong>, {l.city}, {l.state}. Claiming is free. You get an account to edit the listing, add photos, and receive quote requests.</p>
  {l.is_claimed === 1 && <div class="notice warn">This listing has already been claimed. If that was not you, <a href={`/company/${l.slug}/report`}>tell us</a>.</div>}
  {msg === 'invalid' && <div class="notice error" role="alert">That did not work. Check the email address and try again.</div>}
  {msg === 'wrong-code' && <div class="notice error" role="alert">Wrong or expired code. Request a new one.</div>}
  {msg === 'captcha' && <div class="notice error" role="alert">The spam check did not pass. Reload and try again.</div>}
  {l.is_claimed !== 1 && step === 'email' && (
    <form action="/api/claim/start" method="post" style="max-width:480px">
      <input type="hidden" name="listing_id" value={l.id} />
      <label for="email">Business email</label>
      <input id="email" name="email" type="email" required maxlength="254" placeholder={l.website ? `you@${new URL(l.website).hostname.replace('www.', '')}` : 'you@yourcompany.com'} />
      <p class="hint">We email a 6-digit code to confirm you can receive mail at this address. An address on the company's own domain is approved immediately; others are reviewed by a person first.</p>
      {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-size="flexible" style="margin-top:12px"></div>}
      <button class="btn" type="submit" style="margin-top:12px">Send code</button>
    </form>
  )}
  {l.is_claimed !== 1 && step === 'code' && (
    <form action="/api/claim/verify" method="post" style="max-width:480px">
      <input type="hidden" name="listing_id" value={l.id} />
      <input type="hidden" name="email" value={email} />
      <p>We sent a code to <strong>{email}</strong>. It is valid for 20 minutes.</p>
      <label for="code">6-digit code</label>
      <input id="code" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autocomplete="one-time-code" />
      <button class="btn" type="submit" style="margin-top:12px">Confirm</button>
      <p class="small" style="margin-top:12px"><a href={`/claim/${l.slug}`}>Use a different email</a></p>
    </form>
  )}
  {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</Base>

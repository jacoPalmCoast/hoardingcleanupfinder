---
import Base from '../../layouts/Base.astro';
import ListingCard from '../../components/ListingCard.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import Faq from '../../components/Faq.astro';
import Socials from '../../components/Socials.astro';
import Reviews from '../../components/Reviews.astro';
import { getListingBySlug, nearbyListings, isLive, approvedReviews } from '../../lib/db';
import { currentOwner, ownerOwns } from '../../lib/services';
import { formatPhone, parseServices, hostOf, isoDay } from '../../lib/util';
import { SERVICE_BY_SLUG } from '../../data/services';
import { STATES } from '../../data/states';
import { parseAttrs, parseFaq, attrFacts, publicAttrs } from '../../data/attrs';
import { listingIntents } from '../../data/intents';
import { listingSchema, webPageSchema, breadcrumbSchema } from '../../lib/seo';
import { trackEvent, waitCtx } from '../../lib/events';
import { env } from '../../lib/env';

const l = await getListingBySlug(Astro.params.slug ?? '');
if (!l || l.status !== 'active') return new Response(null, { status: 404 });

// Owner preview: signed-in owner of this listing can see it rendered as a full
// featured profile before paying, via ?preview=1. Gated to the owner so nobody
// else can surface unpaid featured content, and never counted as a real view.
const liveFeatured = isLive(l);
const wantPreview = Astro.url.searchParams.get('preview') === '1';
let previewing = false;
if (wantPreview && !liveFeatured) {
  const owner = await currentOwner(Astro.request);
  previewing = !!owner && (await ownerOwns(owner.id, l.id));
}
// A preview response carries owner-gated content and must never be cached or shared.
if (previewing) Astro.response.headers.set('cache-control', 'private, no-store');
// Count this page view (real visitors only; bots are filtered inside trackEvent).
if (!previewing) trackEvent('view', l.id, Astro.request, 'company', waitCtx(Astro.locals));
const services = parseServices(l.services);
const serviceNames = services.map((s) => SERVICE_BY_SLUG[s]?.name).filter(Boolean) as string[];
const featured = liveFeatured || previewing;
// Render-time tier gate: stored featured-only attributes are hidden while not featured.
const attrs = publicAttrs(parseAttrs(l.attrs), featured);
const facts = attrFacts(attrs);
// Custom FAQ and long "About" are featured-only content; if a subscription lapses they stop rendering.
const customFaq = featured ? parseFaq(l.custom_faq) : [];
const longAbout = featured && l.long_about ? l.long_about.trim() : '';
const faq = [...customFaq, ...listingIntents(l, services, attrs, serviceNames)];
const nearby = l.lat && l.lng ? await nearbyListings(l.lat, l.lng, 6, l.id) : [];
// Guarded so a review-table hiccup can never take down a public company page.
let reviews: Awaited<ReturnType<typeof approvedReviews>> = [];
try { reviews = await approvedReviews(l.id); } catch { reviews = []; }
const stateName = STATES[l.state] ?? l.state;
const msg = Astro.url.searchParams.get('msg');
const url = `${env.SITE_URL}/company/${l.slug}`;
const description = `${l.name} provides ${serviceNames.map((n) => n.toLowerCase()).join(', ')} in ${l.city}, ${stateName}${attrs.hours24 ? ', available 24 hours' : ''}. Phone, website, certifications and quote request.`;
const jsonld = [
  webPageSchema(url, `${l.name} — ${l.city}, ${l.state}`, description, { speakable: true, dateModified: isoDay(l.updated_at) ?? undefined }),
  breadcrumbSchema([{ name: 'Home', url: env.SITE_URL }, { name: stateName, url: `${env.SITE_URL}/state/${l.state.toLowerCase()}` }, { name: l.city, url: `${env.SITE_URL}/${l.state.toLowerCase()}/${l.city_slug}` }, { name: l.name }]),
  ...listingSchema(l, services, attrs, faq),
];
// Paragraphs only; owners type plain text, we never render their HTML.
const aboutParas = longAbout ? longAbout.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean).slice(0, 8) : [];
const gaps: string[] = [];
if (l.is_claimed !== 1) {
  if (!attrs.certifications.length) gaps.push('certifications');
  if (!attrs.languages.length) gaps.push('languages');
  if (!attrs.service_area.length) gaps.push('service area');
}
---

<Base title={`${l.name} — ${l.city}, ${l.state}`} description={description} jsonld={jsonld} noindex={previewing}>
  {previewing && (
    <div class="preview-bar" role="status">
      <div class="pb-msg"><span class="pb-tag">Preview</span> This is how <b>{l.name}</b> looks featured — it isn't live yet.</div>
      <div class="pb-act">
        <a class="pb-exit" href={`/company/${l.slug}`}>Exit preview</a>
        <a class="pb-cta" href={`/featured/${l.slug}`}>Get featured</a>
      </div>
    </div>
  )}
  <p class="crumbs"><a href="/">Home</a> › <a href={`/state/${l.state.toLowerCase()}`}>{stateName}</a> › <a href={`/${l.state.toLowerCase()}/${l.city_slug}`}>{l.city}</a> › {l.name}</p>
  {msg === 'lead-sent' && <div class="notice" role="status">Your request was sent. Expect a call or email from the company, usually within one business day.</div>}
  {msg === 'report-sent' && <div class="notice" role="status">Thanks. We review every report within one business day.</div>}
  {msg === 'review-received' && <div class="notice" role="status">Thanks — your review was received. A person checks each one before it goes live, usually within one business day.</div>}
  <div class="two">
    <article>
      <div class="badges">
        {featured && <span class="badge featured">Featured</span>}
        {l.is_verified === 1 && <span class="badge verified">Verified</span>}
        {l.is_claimed === 1 && <span class="badge claimed">Owner-managed</span>}
        {attrs.hours24 && <span class="badge">24 hours</span>}
      </div>
      <h1>{l.name}</h1>
      <p class="lede">{l.description ?? `${l.name} serves ${l.city}, ${stateName} and the surrounding area.`}</p>
      <dl class="facts">
        <dt>Services</dt><dd>{serviceNames.join(', ') || '—'}</dd>
        <dt>Phone</dt><dd>{l.phone ? <a href={`/api/go/call/${l.id}?s=company`} rel="nofollow">{formatPhone(l.phone)}</a> : '—'}</dd>
        <dt>Website</dt><dd>{l.website ? <a href={`/api/go/website/${l.id}?s=company`} rel="nofollow noopener" target="_blank">{hostOf(l.website)}<span class="sr-only"> (opens in new tab)</span></a> : '—'}</dd>
        <dt>Location</dt><dd>{l.address ? `${l.address}` : `${l.city}, ${l.state}${l.zip ? ' ' + l.zip : ''}`}</dd>
        {facts.map((f) => <><dt>{f.label}</dt><dd>{f.value}</dd></>)}
        {l.review_count > 0 && l.rating && <><dt>Reviews</dt><dd>{l.place_id
          ? <a href={`https://www.google.com/maps/place/?q=place_id:${l.place_id}`} rel="nofollow noopener" target="_blank">★ {l.rating.toFixed(1)} · {l.review_count} Google reviews<span class="sr-only"> (opens in new tab)</span></a>
          : <>★ {l.rating.toFixed(1)} · {l.review_count} reviews</>}</dd></>}
      </dl>
      {gaps.length > 0 && (
        <p class="small">Not provided yet: {gaps.join(', ')}. <a href={`/claim/${l.slug}`}>Claim this listing</a> to add them.</p>
      )}
      <div class="actions" style="display:flex;gap:8px;flex-wrap:wrap">
        {l.phone && <a class="btn" href={`/api/go/call/${l.id}?s=company`} rel="nofollow">Call {formatPhone(l.phone)}</a>}
        <a class="btn secondary" href="#quote">Request a quote</a>
      </div>
      <Socials attrs={attrs} />

      {aboutParas.length > 0 && (
        <section class="prose">
          <h2>About {l.name}</h2>
          {aboutParas.map((p) => <p>{p}</p>)}
          <p class="small">Written by the company.</p>
        </section>
      )}

      <section class="prose">
        <h2>Before you call</h2>
        <p>Ask three things: does the crew have bloodborne-pathogen training and insurance, how do they dispose of contaminated material, and will they give a written estimate after seeing the property. For hoarding jobs, ask how they work with the resident. Our guide on <a href="/guides/how-to-choose-a-hoarding-cleanup-company">choosing a cleanup company</a> covers the rest.</p>
      </section>

      <Faq items={faq} heading={`Questions about ${l.name}`} />

      <Reviews reviews={reviews} name={l.name} reviewUrl={`/company/${l.slug}/review`} />

      <section class="small" style="margin-top:32px">
        <p>
          {l.is_claimed !== 1 && <><strong>Is this your company?</strong> <a href={`/claim/${l.slug}`}>Claim this listing</a> to correct details, add certifications and your service area. </>}
          <a href={`/company/${l.slug}/report`}>Report a correction or ask for removal</a>.
          {!featured && <> Companies can also <a href={`/featured/${l.slug}`}>get featured</a> in {l.city}.</>}
        </p>
      </section>

      {nearby.length > 0 && (
        <section>
          <h2>Other companies near {l.city}</h2>
          <div class="grid">{nearby.map((n) => <ListingCard l={n} />)}</div>
        </section>
      )}
    </article>
    <aside><QuoteForm listingId={l.id} city={l.city} state={l.state} heading={`Request a quote from ${l.name}`} /></aside>
  </div>
</Base>

<style>
  .preview-bar { position: sticky; top: 0; z-index: 60; background: var(--teal); color: #fff; margin: 0 0 18px; padding: 10px 16px; border-radius: 0 0 12px 12px; display: flex; align-items: center; justify-content: space-between; gap: 10px 16px; flex-wrap: wrap; box-shadow: 0 6px 22px rgba(15,109,106,.18); }
  .pb-msg { font-size: .92rem; line-height: 1.4; }
  .pb-msg b { font-weight: 600; }
  .pb-tag { display: inline-block; font-size: .68rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; background: rgba(255,255,255,.18); padding: 2px 8px; border-radius: 999px; margin-right: 8px; vertical-align: middle; }
  .pb-act { display: flex; align-items: center; gap: 8px 14px; flex-wrap: wrap; }
  .pb-exit { color: #fff; text-decoration: underline; text-underline-offset: 2px; font-size: .88rem; font-weight: 500; }
  .pb-cta { background: #fff; color: var(--teal); font-weight: 700; font-size: .9rem; padding: 8px 16px; border-radius: 8px; text-decoration: none; white-space: nowrap; }
  .pb-cta:hover { background: #f3f7f6; }
</style>

---
import Admin from '../../../layouts/Admin.astro';
import { getFeedback, FEEDBACK_STATUSES } from '../../../lib/feedback';
import { tsToDate } from '../../../lib/util';

const id = Number(Astro.params.id);
if (!Number.isInteger(id)) return Astro.redirect('/admin/feedback');
const f = await getFeedback(id);
if (!f) return new Response(null, { status: 404 });
const back = `/admin/feedback/${id}`;

let ctx: any = null;
try { ctx = f.context ? JSON.parse(f.context) : null; } catch { ctx = null; }
const ua = ctx?.ua ?? '';
const device = /mobile|iphone|android|ipad|ipod/i.test(ua) ? 'Mobile' : ua ? 'Desktop' : '—';
const browser = /edg\//i.test(ua) ? 'Edge' : /chrome|crios/i.test(ua) ? 'Chrome' : /firefox|fxios/i.test(ua) ? 'Firefox' : /safari/i.test(ua) ? 'Safari' : ua ? 'Other' : '—';
const when = (t: unknown) => { const d = tsToDate(t); return d ? d.toLocaleString('en-US', { timeZone: 'America/New_York' }) : '—'; };
const TYPE_PILL: Record<string, string> = { bug: 'bad', idea: 'brand', other: 'muted' };
const STATUS_PILL: Record<string, string> = { new: 'brand', triaged: 'info', planned: 'warn', shipped: 'ok', declined: 'muted' };
const SEV_PILL: Record<string, string> = { blocker: 'bad', annoying: 'warn', minor: 'muted' };
const crumbs = [{ label: 'Feedback', href: '/admin/feedback' }];
const msg = Astro.url.searchParams.get('msg');
---
<Admin title={`Feedback #${f.id}`} crumbs={crumbs}>
  <p slot="sub" class="sub">{f.reporters}× reported · score {f.score} · received {when(f.created_at)}</p>

  {msg === 'saved' && <div class="notice" role="status">Saved.</div>}

  <div class="fd-grid">
    <div>
      <div class="card" style="margin-bottom:16px">
        <div class="card-b">
          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px">
            <span class={`pill ${TYPE_PILL[f.type] ?? 'muted'}`}>{f.type}</span>
            {f.severity && <span class={`pill ${SEV_PILL[f.severity] ?? 'muted'}`}>{f.severity}</span>}
            <span class={`pill ${STATUS_PILL[f.status] ?? 'muted'}`}>{f.status}</span>
            {f.reporters > 1 && <span class="pill info">{f.reporters}× reported</span>}
          </div>
          <div style="white-space:pre-wrap;font-size:1.02rem;line-height:1.5">{f.message}</div>
          <div class="sub2" style="margin-top:10px">{f.email ? <>From <a href={`mailto:${f.email}`}>{f.email}</a></> : 'No email left'}</div>
        </div>
      </div>

      {f.shot_key && (
        <div class="card" style="margin-bottom:16px">
          <div class="card-h"><h3>Screenshot</h3><a class="linkish" href={`/api/admin/feedback-shot?id=${f.id}`} target="_blank" rel="noopener">Open full size ↗</a></div>
          <div class="card-b"><a href={`/api/admin/feedback-shot?id=${f.id}`} target="_blank" rel="noopener"><img src={`/api/admin/feedback-shot?id=${f.id}`} alt="Screenshot of the page the visitor was on" style="width:100%;border:1px solid #e0e5e5;border-radius:8px;display:block" /></a></div>
        </div>
      )}
    </div>

    <div>
      <div class="card" style="margin-bottom:16px">
        <div class="card-h"><h3>Manage</h3></div>
        <div class="card-b">
          <form action="/api/admin/feedback" method="post" style="margin-bottom:12px">
            <input type="hidden" name="action" value="status" /><input type="hidden" name="id" value={f.id} /><input type="hidden" name="back" value={back} />
            <label class="fh">Status</label>
            <select name="status" onchange="this.form.requestSubmit()">
              {FEEDBACK_STATUSES.map((s) => <option value={s} selected={s === f.status}>{s}</option>)}
            </select>
          </form>
          <form action="/api/admin/feedback" method="post" style="margin-bottom:12px">
            <input type="hidden" name="action" value="priority" /><input type="hidden" name="id" value={f.id} /><input type="hidden" name="back" value={back} />
            <label class="fh">Priority (0–9, higher = sooner)</label>
            <input type="number" name="priority" min="0" max="9" value={f.priority ?? ''} placeholder="—" style="width:80px" onchange="this.form.requestSubmit()" />
          </form>
          <form action="/api/admin/feedback" method="post">
            <input type="hidden" name="action" value="note" /><input type="hidden" name="id" value={f.id} /><input type="hidden" name="back" value={back} />
            <label class="fh">Internal note</label>
            <textarea name="note" maxlength="1000" style="min-height:70px">{f.admin_notes ?? ''}</textarea>
            <button class="btn small secondary" type="submit" style="margin-top:6px">Save note</button>
          </form>
          <form action="/api/admin/feedback" method="post" style="margin-top:14px" onsubmit="return confirm('Delete this feedback? This cannot be undone.')">
            <input type="hidden" name="action" value="delete" /><input type="hidden" name="id" value={f.id} />
            <button class="linkbtn" type="submit" style="color:var(--a-bad,#b3261e);font-size:.85rem">Delete feedback</button>
          </form>
        </div>
      </div>

      <div class="card">
        <div class="card-h"><h3>Context</h3></div>
        <div class="card-b">
          <dl class="ctx">
            <dt>Page</dt><dd>{ctx?.full_url ? <a href={ctx.full_url} target="_blank" rel="noopener">{f.page_url ?? ctx.full_url}</a> : (f.page_url ?? '—')}{ctx?.full_url && <> · <a href={ctx.full_url} target="_blank" rel="noopener">reproduce ↗</a></>}</dd>
            <dt>Device</dt><dd>{device} · {browser}</dd>
            {ctx?.viewport && <><dt>Viewport</dt><dd>{ctx.viewport.w}×{ctx.viewport.h}{ctx.viewport.dpr ? ` @${ctx.viewport.dpr}x` : ''}</dd></>}
            {ctx?.referrer && <><dt>Referrer</dt><dd style="word-break:break-all">{ctx.referrer}</dd></>}
            {ua && <><dt>User agent</dt><dd style="word-break:break-all;font-size:.78rem">{ua}</dd></>}
          </dl>
          {ctx?.errors && ctx.errors.length > 0 && (
            <>
              <p class="fh" style="margin-top:12px">JS errors on the page</p>
              <ul class="errs">{ctx.errors.map((e: string) => <li>{e}</li>)}</ul>
            </>
          )}
        </div>
      </div>
    </div>
  </div>
</Admin>

<style>
  .fd-grid { display: grid; grid-template-columns: 1fr 340px; gap: 16px; align-items: start; }
  @media (max-width: 820px) { .fd-grid { grid-template-columns: 1fr; } }
  .ctx { margin: 0; display: grid; grid-template-columns: 92px 1fr; gap: 6px 12px; font-size: .88rem; }
  .ctx dt { color: var(--a-muted, #6b7777); font-weight: 600; }
  .ctx dd { margin: 0; }
  .errs { margin: 6px 0 0; padding-left: 18px; font-size: .8rem; color: var(--a-bad, #b3261e); }
  .errs li { margin: 3px 0; word-break: break-word; }
  .fh { display: block; font-weight: 600; font-size: .85rem; margin-bottom: 4px; }
</style>

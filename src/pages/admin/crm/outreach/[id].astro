---
import Admin from '../../../../layouts/Admin.astro';
import { getCampaign, campaignStats, previewCount, isSegment, SEGMENTS } from '../../../../lib/outreach';
import { mailingAddress } from '../../../../lib/settings';

const id = Number(Astro.params.id);
if (!Number.isInteger(id)) return new Response(null, { status: 404 });
const c = await getCampaign(id);
if (!c) return new Response(null, { status: 404 });
const stats = await campaignStats(id);
const audience = isSegment(c.segment) ? await previewCount(c.segment) : 0;
const segLabel = SEGMENTS.find((s) => s.key === c.segment)?.label ?? c.segment;
const ready = !!(await mailingAddress());
const total = stats.queued + stats.sent + stats.failed + stats.suppressed;
const STATUS_PILL: Record<string, string> = { draft: 'muted', queued: 'info', sending: 'info', paused: 'warn', sent: 'ok', done: 'ok' };
---
<Admin title={c.name}>
  <p slot="sub" class="sub">{segLabel} · {audience.toLocaleString('en-US')} in audience with an email</p>
  <Fragment slot="actions">
    <span class={`pill ${STATUS_PILL[c.status] ?? 'muted'}`} style="align-self:center">{c.status}</span>
    <a class="btn secondary small" href="/admin/crm/outreach"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>Outreach</a>
  </Fragment>

  <div class="kpis" style="margin-bottom:16px">
    <div class="kpi"><div class="lab">Queued</div><div class="val tnum">{stats.queued.toLocaleString('en-US')}</div><div class="delta flat">waiting to send</div></div>
    <div class="kpi"><div class="lab">Sent</div><div class="val tnum">{stats.sent.toLocaleString('en-US')}</div><div class="delta flat">delivered to Resend</div></div>
    <div class="kpi"><div class="lab">Failed</div><div class="val tnum">{stats.failed.toLocaleString('en-US')}</div><div class="delta flat">{stats.suppressed.toLocaleString('en-US')} suppressed</div></div>
    <div class="kpi"><div class="lab">Total recipients</div><div class="val tnum">{total.toLocaleString('en-US')}</div><div class="delta flat">across all states</div></div>
  </div>

  {(total === 0 || c.status === 'sending' || c.status === 'paused') && (
    <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap">
      {total === 0 ? (
        <form action="/api/admin/outreach" method="post"><input type="hidden" name="action" value="queue" /><input type="hidden" name="campaign_id" value={id} /><button class="btn" type="submit">Queue {audience.toLocaleString('en-US')} recipients</button></form>
      ) : c.status === 'sending' ? (
        <form action="/api/admin/outreach" method="post"><input type="hidden" name="action" value="pause" /><input type="hidden" name="campaign_id" value={id} /><button class="btn secondary" type="submit">Pause sending</button></form>
      ) : c.status === 'paused' ? (
        <form action="/api/admin/outreach" method="post"><input type="hidden" name="action" value="resume" /><input type="hidden" name="campaign_id" value={id} /><button class="btn" type="submit">Resume sending</button></form>
      ) : null}
    </div>
  )}

  {!ready && stats.queued > 0 && <div class="notice warn">Recipients are queued but held — nothing sends until <code>MAILING_ADDRESS</code> is set and the Resend domain is verified. Once it is, the daily job sends up to 40/day automatically.</div>}
  {ready && c.status === 'sending' && stats.queued > 0 && <div class="notice">Sending up to 40/day on the daily job. Suppressed/unsubscribed addresses are skipped automatically.</div>}

  <div class="card">
    <div class="card-h"><h3>Message</h3><span class="hint">raw template</span></div>
    <div class="card-b">
      <p style="margin:0 0 10px"><strong>Subject:</strong> {c.subject}</p>
      <div style="white-space:pre-wrap;padding-top:10px;border-top:1px solid var(--a-border);color:var(--a-ink)">{c.body}</div>
    </div>
  </div>
  <p class="sub" style="margin-top:10px">Preview shows the raw template; merge fields fill in per recipient at send time.</p>
</Admin>

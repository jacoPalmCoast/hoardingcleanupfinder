---
import Admin from '../../../layouts/Admin.astro';
import { listCampaigns, previewCount, SEGMENTS } from '../../../lib/outreach';
import { mailingAddress } from '../../../lib/settings';
import { tsToDate } from '../../../lib/util';

const campaigns = await listCampaigns();
const counts = Object.fromEntries(await Promise.all(SEGMENTS.map(async (s) => [s.key, await previewCount(s.key)] as const)));
const ready = !!(await mailingAddress());
const msg = Astro.url.searchParams.get('msg');
const when = (ts: number) => tsToDate(ts)?.toLocaleDateString('en-US') ?? '';
const STATUS_PILL: Record<string, string> = { draft: 'muted', queued: 'info', sending: 'info', paused: 'warn', sent: 'ok', done: 'ok' };
---
<Admin title="Outreach">
  <p slot="sub" class="sub">Draft and send email campaigns to companies in the directory</p>
  <Fragment slot="actions">
    <a class="btn secondary small" href="/admin/crm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>Pipeline</a>
    <a class="btn secondary small" href="/admin/crm/enrichment"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4-4"/></svg>Enrichment</a>
  </Fragment>

  {msg === 'invalid' && <div class="notice error" role="alert">Fill in a name, subject, body and a valid segment.</div>}
  {!ready && (
    <div class="notice warn">
      <strong>Sending is off until marketing is set up.</strong> Campaigns save and queue, but nothing sends until <code>MAILING_ADDRESS</code> is set and your Resend domain is verified (so mail sends from your own domain with a valid unsubscribe footer). Until then this is a safe place to draft.
    </div>
  )}

  <div class="two-6-4">
    <div class="card">
      <div class="card-h"><h3>New campaign</h3></div>
      <div class="card-b">
        <form action="/api/admin/outreach" method="post">
          <input type="hidden" name="action" value="create" />
          <div class="field"><label for="name">Campaign name <span class="fh" style="display:inline">(internal)</span></label><input id="name" name="name" type="text" required maxlength="120" /></div>
          <div class="field"><label for="segment">Who it goes to</label>
            <select id="segment" name="segment">
              {SEGMENTS.map((s) => <option value={s.key}>{s.label} — {counts[s.key].toLocaleString('en-US')} with an email</option>)}
            </select>
          </div>
          <div class="field"><label for="subject">Subject</label><input id="subject" name="subject" type="text" required maxlength="150" /></div>
          <div class="field"><label for="body">Message</label>
            <textarea id="body" name="body" rows="8" required maxlength="6000" placeholder="Hi {{first_name}}, your company {{name}} in {{city}} is listed free on Hoarding Cleanup Finder…"></textarea>
            <div class="fh">Merge fields: <code>{'{{first_name}}'}</code> (falls back to "there") <code>{'{{contact_name}}'}</code> <code>{'{{name}}'}</code> (company) <code>{'{{city}}'}</code> <code>{'{{state}}'}</code> <code>{'{{claim_url}}'}</code> <code>{'{{featured_url}}'}</code>. Basic HTML is fine. An unsubscribe line and your mailing address are added automatically.</div>
          </div>
          <button class="btn" type="submit">Create campaign</button>
        </form>
      </div>
    </div>

    <div class="card" style="align-self:start">
      <div class="card-h"><h3>Campaigns</h3>{campaigns.length > 0 && <span class="hint">{campaigns.length}</span>}</div>
      {campaigns.length === 0 ? (
        <div class="empty" style="padding:26px 20px"><div class="ei"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13M22 2 15 22l-4-9-9-4Z"/></svg></div><b>No campaigns yet</b>Create one on the left to get started.</div>
      ) : (
        <div class="table-wrap"><table>
          <thead><tr><th>Name</th><th>Segment</th><th>Status</th><th style="text-align:right">Queued</th><th style="text-align:right">Sent</th><th>Created</th></tr></thead>
          <tbody>
            {campaigns.map((c) => (
              <tr>
                <td><a class="co" href={`/admin/crm/outreach/${c.id}`}>{c.name}</a></td>
                <td class="mut">{c.segment}</td>
                <td><span class={`pill ${STATUS_PILL[c.status] ?? 'muted'}`}>{c.status}</span></td>
                <td class="tnum" style="text-align:right">{c.queued.toLocaleString('en-US')}</td>
                <td class="tnum" style="text-align:right">{c.sent.toLocaleString('en-US')}</td>
                <td class="mut" style="white-space:nowrap">{when(c.created_at)}</td>
              </tr>
            ))}
          </tbody>
        </table></div>
      )}
    </div>
  </div>
</Admin>

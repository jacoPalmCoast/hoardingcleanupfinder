---
import Admin from '../../../layouts/Admin.astro';
import { listTickets } from '../../../lib/tickets';
import { tsToDate } from '../../../lib/util';

const statusParam = (Astro.url.searchParams.get('status') ?? 'open').toLowerCase();
const status = statusParam === 'closed' ? 'closed' : statusParam === 'all' ? null : 'open';
const rows = await listTickets(status);
const when = (ts: number) => tsToDate(ts)?.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) ?? '';
const tab = (key: string, label: string) => ({ key, label });
const tabs = [tab('open', 'Open'), tab('closed', 'Closed'), tab('all', 'All')];
---
<Admin title="Support inbox">
  <nav class="small" style="margin:-6px 0 12px"><a href="/admin/crm">← Pipeline</a> · Show: {tabs.map((x) => (statusParam === x.key ? <strong style="margin-right:8px">{x.label}</strong> : <a href={`/admin/crm/tickets?status=${x.key}`} style="margin-right:8px">{x.label}</a>))}</nav>
  {rows.length === 0 ? <p>No {status ?? ''} tickets.</p> : (
    <div class="table-wrap"><table><thead><tr><th>Updated</th><th>Subject</th><th>From</th><th>Company</th><th>Status</th></tr></thead><tbody>
      {rows.map((r) => (
        <tr>
          <td style="white-space:nowrap">{when(r.updated_at)}</td>
          <td><a href={`/admin/crm/ticket/${r.id}`}>{r.subject}</a> <span class="small">({r.msgs})</span></td>
          <td>{r.from_email}</td>
          <td style="white-space:nowrap">{r.listing_id ? <a href={`/admin/crm/${r.listing_id}`}>{r.company}</a> : '—'}</td>
          <td>{r.status}</td>
        </tr>
      ))}
    </tbody></table></div>
  )}
</Admin>

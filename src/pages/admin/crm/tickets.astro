---
import Admin from '../../../layouts/Admin.astro';
import { listTickets, ticketCounts } from '../../../lib/tickets';
import { tsToDate } from '../../../lib/util';

const statusParam = (Astro.url.searchParams.get('status') ?? 'open').toLowerCase();
const status = statusParam === 'closed' ? 'closed' : statusParam === 'pending' ? 'pending' : statusParam === 'all' ? null : 'open';
const [rows, counts] = await Promise.all([listTickets(status), ticketCounts()]);
const when = (ts: number) => tsToDate(ts)?.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) ?? '';
// Arrival date + time in Eastern (the admin's timezone) so "when it came in" is precise, not UTC.
const whenDT = (ts: number) => tsToDate(ts)?.toLocaleString('en-US', { timeZone: 'America/New_York', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) ?? '';
const tabs = [
  { key: 'open', label: 'Open', n: counts.open },
  { key: 'pending', label: 'Review', n: counts.pending, warn: true },
  { key: 'closed', label: 'Closed', n: counts.closed },
  { key: 'all', label: 'All', n: counts.all },
];
const STATUS_PILL: Record<string, string> = { open: 'info', pending: 'warn', closed: 'muted' };
---
<Admin title="Support inbox" crumbs={[{ label: 'CRM', href: '/admin/crm' }]}>
  <p slot="sub" class="sub">Customer emails routed into tickets{counts.pending > 0 ? ` · ${counts.pending} held for review` : ''}</p>
  <Fragment slot="actions"><a class="btn secondary small" href="/admin/crm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>Pipeline</a></Fragment>

  {counts.pending > 0 && statusParam !== 'pending' && (
    <div class="notice warn" role="status" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:14px">
      <span><strong>{counts.pending}</strong> email{counts.pending === 1 ? '' : 's'} held for review — from senders that don't match a known listing.</span>
      <a class="btn small" href="/admin/crm/tickets?status=pending">Review {counts.pending === 1 ? 'it' : 'them'}</a>
    </div>
  )}

  <div class="card">
    <div class="card-h">
      <div class="seg">
        {tabs.map((x) => <a class={statusParam === x.key ? 'on' : ''} href={`/admin/crm/tickets?status=${x.key}`}>{x.label}{x.n > 0 ? <span class={`tabn${x.warn ? ' warn' : ''}`}>{x.n}</span> : ''}</a>)}
      </div>
    </div>
    {statusParam === 'pending' && rows.length > 0 && <div class="card-b" style="padding-top:0"><p class="sub" style="margin:0">These emails are from senders that don't match a known listing. Open each to approve or reject.</p></div>}
    {rows.length === 0 ? (
      <div class="empty"><div class="ei"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2.5"/><path d="m3 6 9 6 9-6"/></svg></div><b>No {status ?? ''} tickets</b>Customer emails land here as they arrive.</div>
    ) : (
      <form id="bulkform" method="post" action="/api/admin/ticket">
        <input type="hidden" name="tab" value={statusParam} />
        <div class="bulkbar">
          <span id="selCount" class="mut">None selected</span>
          <span style="flex:1"></span>
          <button class="btn small secondary bulk-btn" name="action" value="bulk_close" type="submit" disabled>Close</button>
          <button class="btn small secondary bulk-btn" name="action" value="bulk_open" type="submit" disabled>Reopen</button>
          <button class="btn small bulk-btn danger" name="action" value="bulk_delete" type="submit" disabled onclick="return bulkDeleteConfirm(event)">Delete</button>
        </div>
        <div class="table-wrap"><table>
          <thead><tr><th class="chk"><input type="checkbox" id="selAll" aria-label="Select all on this page" /></th><th>Received</th><th>Updated</th><th>Subject</th><th>From</th><th>Company</th><th>Status</th></tr></thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td class="chk"><input type="checkbox" class="tsel" name="ids" value={r.id} aria-label={`Select ticket ${r.id}`} /></td>
                <td class="mut" style="white-space:nowrap">{whenDT(r.created_at)}</td>
                <td class="mut" style="white-space:nowrap">{when(r.updated_at)}</td>
                <td><a class="co" href={`/admin/crm/ticket/${r.id}`}>{r.subject}</a> <span class="mut">({r.msgs})</span></td>
                <td class="mut">{r.from_email}</td>
                <td style="white-space:nowrap">{r.listing_id ? <a class="linkish" href={`/admin/crm/${r.listing_id}`}>{r.company}</a> : <span class="mut">—</span>}</td>
                <td><span class={`pill ${STATUS_PILL[r.status] ?? 'muted'}`}><span class="dot"></span>{r.status}</span></td>
              </tr>
            ))}
          </tbody>
        </table></div>
      </form>
    )}
  </div>
</Admin>

<style>
  .bulkbar { display: flex; align-items: center; gap: 8px; padding: 10px 16px; border-bottom: 1px solid var(--a-border); }
  .bulkbar .bulk-btn:disabled { opacity: .45; pointer-events: none; }
  .bulkbar .danger { color: var(--a-bad); }
  th.chk, td.chk { width: 34px; padding-right: 0; text-align: center; }
  td.chk input, th.chk input { width: 16px; height: 16px; cursor: pointer; }
  .co { text-decoration: none; font-weight: 600; }
  .co:hover { text-decoration: underline; }
  .tabn { display: inline-block; margin-left: 6px; min-width: 18px; padding: 0 6px; border-radius: 999px; background: var(--a-soft, #eef2f2); color: var(--a-muted); font-size: 11.5px; line-height: 18px; text-align: center; font-weight: 600; }
  .seg a.on .tabn { background: rgba(255,255,255,.25); color: #fff; }
  .tabn.warn { background: var(--a-warn-soft, #fbf1de); color: var(--a-warn, #a9740d); }
</style>

<script is:inline>
  (function () {
    var form = document.getElementById('bulkform');
    if (!form) return;
    var all = document.getElementById('selAll');
    var count = document.getElementById('selCount');
    function boxes() { return Array.prototype.slice.call(form.querySelectorAll('.tsel')); }
    function sync() {
      var b = boxes();
      var n = b.filter(function (x) { return x.checked; }).length;
      count.textContent = n === 0 ? 'None selected' : (n + ' selected');
      form.querySelectorAll('.bulk-btn').forEach(function (btn) { btn.disabled = n === 0; });
      if (all) all.checked = n > 0 && n === b.length;
    }
    if (all) all.addEventListener('change', function () { boxes().forEach(function (x) { x.checked = all.checked; }); sync(); });
    form.addEventListener('change', function (e) { if (e.target && e.target.classList.contains('tsel')) sync(); });
    sync();
    window.bulkDeleteConfirm = function (e) {
      var n = boxes().filter(function (x) { return x.checked; }).length;
      if (n === 0) { e.preventDefault(); return false; }
      if (!confirm('Delete ' + n + ' ticket' + (n === 1 ? '' : 's') + '? This permanently removes them and their messages and attachments.')) { e.preventDefault(); return false; }
      return true;
    };
  })();
</script>

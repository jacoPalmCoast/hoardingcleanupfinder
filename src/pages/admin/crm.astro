---
import Admin from '../../layouts/Admin.astro';
import { pipelineCounts, pipelineList, STAGES, STAGE_LABEL } from '../../lib/crm';
import { pendingTicketCount } from '../../lib/tickets';
import { tsToDate } from '../../lib/util';

const stageParam = (Astro.url.searchParams.get('stage') ?? '').toLowerCase();
const stage = STAGES.includes(stageParam as never) ? stageParam : '';
const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 60);

const counts = await pipelineCounts();
const rows = await pipelineList(stage || null, q, 150);
const support = await pendingTicketCount().catch(() => 0);
const total = STAGES.reduce((a, s) => a + (counts[s] ?? 0), 0);

const when = (ts: number | null) => (ts ? tsToDate(ts)?.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) ?? '' : '');
const overdue = (ts: number | null) => ts != null && ts < Math.floor(Date.now() / 1000);
const STAGE_PILL: Record<string, string> = { prospect: 'brand', contacted: 'info', claimed: 'ok', featured: 'warn', lapsed: 'muted' };
const initials = (name: string) => name.replace(/[^a-zA-Z0-9 ]/g, '').split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase() || '–';
---
<Admin title="CRM">
  <p slot="sub" class="sub">{total.toLocaleString('en-US')} companies · follow-ups due first</p>
  <Fragment slot="actions">
    <a class="btn secondary small" href="/admin/crm/tasks"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3 8-8M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"/></svg>Tasks</a>
    <a class="btn small" href="/admin/crm/outreach"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13M22 2 15 22l-4-9-9-4Z"/></svg>Outreach</a>
  </Fragment>

  <div class="card" style="margin-bottom:16px">
    <div class="card-h"><h3>Pipeline</h3><span class="hint">Prospect → Contacted → Claimed → Featured → Lapsed</span></div>
    <div class="card-b">
      <div class="pipe">
        <a class={`stage${stage === '' ? ' on' : ''}`} href="/admin/crm"><div class="n tnum">{total.toLocaleString('en-US')}</div><div class="s">All companies</div><div class="bar"><i style="width:100%"></i></div></a>
        {STAGES.map((s) => {
          const n = counts[s] ?? 0;
          const w = total ? Math.max(2, Math.round((n / total) * 100)) : 0;
          return (
            <a class={`stage${stage === s ? ' on' : ''}`} href={`/admin/crm?stage=${s}`}>
              <div class="n tnum">{n.toLocaleString('en-US')}</div>
              <div class="s"><span class={`pill ${STAGE_PILL[s] ?? 'muted'}`} style="padding:1px 8px">{STAGE_LABEL[s]}</span></div>
              <div class="bar"><i style={`width:${w}%`}></i></div>
            </a>
          );
        })}
      </div>
      <div class="quicklinks" style="margin-top:16px">
        <a class="ql" href="/admin/crm/tasks"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3 8-8M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"/></svg>Open tasks</a>
        <a class="ql" href="/admin/crm/tickets"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2.5"/><path d="m3 6 9 6 9-6"/></svg>Support inbox{support > 0 && <span class="n">{support}</span>}</a>
        <a class="ql" href="/admin/crm/outreach"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13M22 2 15 22l-4-9-9-4Z"/></svg>Outreach</a>
        <a class="ql" href="/admin/crm/enrichment"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4-4"/></svg>Email enrichment</a>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-h">
      <form method="get" class="adm-search" style="width:min(340px,60%);margin:0">
        {stage && <input type="hidden" name="stage" value={stage} />}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4-4"/></svg>
        <input type="search" name="q" value={q} placeholder="Search company or city" />
      </form>
      <div class="seg">
        <a class={stage === '' ? 'on' : ''} href="/admin/crm">All</a>
        {STAGES.slice(0, 4).map((s) => <a class={stage === s ? 'on' : ''} href={`/admin/crm?stage=${s}`}>{STAGE_LABEL[s]}</a>)}
      </div>
    </div>
    {rows.length === 0 ? (
      <div class="empty"><div class="ei"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4-4"/></svg></div><b>No companies match</b>{q || stage ? 'Try a different search or stage.' : ''}</div>
    ) : (
      <div class="table-wrap"><table>
        <thead><tr><th>Company</th><th>City</th><th>Stage</th><th>Next follow-up</th><th>Last activity</th><th></th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td><div class="cell-co"><span class="avatar">{initials(r.name)}</span><span class="co" style="font-weight:600">{r.name}</span></div></td>
              <td class="mut" style="white-space:nowrap">{r.city}, {r.state}</td>
              <td><span class={`pill ${STAGE_PILL[r.stage] ?? 'muted'}`}><span class="dot"></span>{STAGE_LABEL[r.stage as never] ?? r.stage}</span></td>
              <td style="white-space:nowrap">{r.next_follow_up ? (overdue(r.next_follow_up) ? <span class="pill bad" style="padding:2px 8px">Due {when(r.next_follow_up)}</span> : <span class="mut">{when(r.next_follow_up)}</span>) : <span class="mut">—</span>}</td>
              <td class="mut" style="white-space:nowrap">{r.last_activity ? when(r.last_activity) : '—'}</td>
              <td class="actions"><a class="linkish" href={`/admin/crm/${r.id}`}>Open</a></td>
            </tr>
          ))}
        </tbody>
      </table></div>
    )}
    <div style="padding:12px 18px;color:var(--a-muted);font-size:12.5px">{rows.length} of {total.toLocaleString('en-US')} shown{stage ? ` · ${STAGE_LABEL[stage as never]}` : ''}{q ? ` · matching “${q}”` : ''}</div>
  </div>
</Admin>

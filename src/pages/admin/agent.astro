---
import Admin from '../../layouts/Admin.astro';
import { agentConfigured } from '../../lib/agent';
import { env } from '../../lib/env';
const configured = agentConfigured();
const backend = env.ANTHROPIC_API_KEY ? 'Claude' : (env.AI ? 'Workers AI (lite)' : 'not configured');
const SUGGESTIONS = [
  'What needs my attention today?',
  'Which cities have search demand but no featured seller?',
  'Summarize the new feedback and suggest what to build first.',
  'Any billing issues or past-due accounts?',
  'How is Test Cleanup Co performing this month?',
];
---
<Admin title="Assistant">
  <p slot="sub" class="sub">Ask about anything on the site — listings, leads, billing, analytics, demand, feedback. Backend: {backend}</p>

  {!configured && <div class="notice error" role="alert">No model is configured. Add an <code>ANTHROPIC_API_KEY</code> secret in Cloudflare for the full agent (tools + actions), or enable Workers AI for a lighter, read-only version.</div>}

  <div id="chat" class="chat" aria-live="polite"></div>

  <div class="sugg" id="sugg">
    {SUGGESTIONS.map((s) => <button type="button" class="chip" data-q={s}>{s}</button>)}
  </div>

  <form id="ask" class="askbar">
    <input id="q" name="q" autocomplete="off" placeholder="Ask the assistant…" aria-label="Ask the assistant" />
    <button class="btn" type="submit" id="send">Send</button>
  </form>
  <p class="sub" style="margin-top:8px">The assistant reads live data and can <strong>propose</strong> changes (status updates, approvals, feedback ranking) — nothing is applied until you press <strong>Confirm</strong> on the card it shows. Actions require the Claude backend.</p>

<script is:inline>
(() => {
  const chat = document.getElementById('chat');
  const form = document.getElementById('ask');
  const input = document.getElementById('q');
  const sugg = document.getElementById('sugg');
  const history = [];
  let busy = false;

  const esc = (s) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
  const fmt = (s) => esc(s).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/\n/g, '<br>');

  function bubble(role, html) {
    const d = document.createElement('div');
    d.className = 'msg ' + role;
    d.innerHTML = html;
    chat.appendChild(d);
    chat.scrollTop = chat.scrollHeight;
    return d;
  }

  function renderActions(container, actions) {
    if (!actions || !actions.length) return;
    const wrap = document.createElement('div');
    wrap.className = 'acts';
    actions.forEach((a) => {
      const card = document.createElement('div');
      card.className = 'act';
      const label = document.createElement('span');
      label.textContent = a.label || (a.tool + ' ' + JSON.stringify(a.input));
      const btn = document.createElement('button');
      btn.type = 'button'; btn.className = 'btn small'; btn.textContent = 'Confirm';
      const skip = document.createElement('button');
      skip.type = 'button'; skip.className = 'btn small secondary'; skip.textContent = 'Dismiss';
      const status = document.createElement('span'); status.className = 'act-status';
      btn.addEventListener('click', async () => {
        btn.disabled = true; skip.disabled = true; status.textContent = 'Applying…';
        try {
          const r = await fetch('/api/admin/agent-act', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ tool: a.tool, input: a.input }) });
          const j = await r.json();
          status.textContent = (j.ok ? '✓ ' : '✗ ') + (j.message || '');
          if (!j.ok) { btn.disabled = false; }
        } catch { status.textContent = '✗ failed'; btn.disabled = false; }
      });
      skip.addEventListener('click', () => { card.remove(); });
      card.append(label, btn, skip, status);
      wrap.appendChild(card);
    });
    container.appendChild(wrap);
  }

  async function ask(q) {
    if (busy || !q.trim()) return;
    busy = true; if (sugg) sugg.style.display = 'none';
    bubble('user', fmt(q));
    history.push({ role: 'user', content: q });
    const thinking = bubble('bot', '<span class="dots">Thinking…</span>');
    try {
      const r = await fetch('/api/admin/agent', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ messages: history }) });
      const j = await r.json();
      thinking.innerHTML = fmt(j.answer || '(no answer)');
      history.push({ role: 'assistant', content: j.answer || '' });
      renderActions(thinking, j.actions);
    } catch {
      thinking.innerHTML = 'Sorry — something went wrong reaching the assistant.';
    }
    busy = false;
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); const q = input.value; input.value = ''; ask(q); });
  if (sugg) sugg.addEventListener('click', (e) => { const b = e.target.closest('.chip'); if (b) { input.value = b.dataset.q; ask(b.dataset.q); } });
})();
</script>
</Admin>

<style>
  .chat { display: flex; flex-direction: column; gap: 12px; margin: 8px 0 16px; min-height: 120px; }
  .msg { max-width: 78%; padding: 11px 14px; border-radius: 14px; line-height: 1.5; font-size: .95rem; }
  .msg.user { align-self: flex-end; background: var(--a-brand, #0f6d6a); color: #fff; border-bottom-right-radius: 4px; }
  .msg.bot { align-self: flex-start; background: var(--a-soft, #eef3f3); color: var(--a-text, #172323); border-bottom-left-radius: 4px; }
  .dots { opacity: .6; }
  .acts { margin-top: 10px; display: grid; gap: 8px; }
  .act { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; background: #fff; border: 1px solid var(--a-border, #d9e0e0); border-radius: 10px; padding: 8px 10px; }
  .act > span:first-child { flex: 1; min-width: 180px; font-size: .9rem; }
  .act .btn { width: auto; }
  .act-status { font-size: .85rem; color: var(--a-muted, #5b6a6a); width: 100%; }
  .sugg { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
  .chip { border: 1px solid var(--a-border, #d9e0e0); background: #fff; border-radius: 999px; padding: 7px 13px; font-size: .86rem; cursor: pointer; color: var(--a-text, #172323); }
  .chip:hover { border-color: var(--a-brand, #0f6d6a); }
  .askbar { display: flex; gap: 10px; }
  .askbar input { flex: 1; }
  .askbar .btn { width: auto; }
</style>

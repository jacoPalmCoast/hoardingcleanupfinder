---
import { socialLinks, type Attrs } from '../data/attrs';
interface Props { attrs: Attrs }
const { attrs } = Astro.props;
const links = socialLinks(attrs);
// Inline SVG per platform (monochrome, currentColor).
const ICONS: Record<string, string> = {
  google: '<path d="M12 11v3h4.3c-.5 2-2.2 3.4-4.3 3.4A5.4 5.4 0 1 1 15.6 8.2l2.1-2.1A8.1 8.1 0 1 0 20 12c0-.35-.03-.68-.08-1z"/>',
  facebook: '<path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H7v3h3v6h3v-6h3l1-3h-4v-2c0-.6.4-1 1-1z"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.3" cy="6.7" r="1.1"/>',
  yelp: '<path d="M13 3l-1 8 5-3zM11 12l-6 2 4 3zM12 14l-1 7 4-4zM14 12l6-1-4-4zM11 12l-3-6-2 6z"/>',
  linkedin: '<path d="M6.5 8H4v11h2.5zM5.2 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zM20 19v-6.3c0-3.4-3.9-3.3-5.3-1.6V8H12v11h2.7v-5.8c0-1.9 2.6-2 2.6 0V19z"/>',
  tiktok: '<path d="M16 3c.3 2 1.6 3.5 3.5 3.8V9c-1.3 0-2.6-.4-3.5-1.1V15a5 5 0 1 1-5-5c.3 0 .7 0 1 .1v2.6a2.4 2.4 0 1 0 1.5 2.2V3z"/>',
  x: '<path d="M4 3h3.5l4 5.6L16.3 3H20l-6 7.8L20.5 21H17l-4.4-6-4.8 6H4l6.4-8.1z"/>',
};
---
{links.length > 0 && (
  <div class="socials" aria-label={`${Astro.props.attrs ? 'Social links' : ''}`}>
    {links.map((l) => (
      <a href={l.url} rel="nofollow noopener" target="_blank" aria-label={l.name} title={l.name}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" set:html={ICONS[l.key] ?? ''}></svg>
        <span class="sr-only">{l.name} (opens in new tab)</span>
      </a>
    ))}
  </div>
)}

<style>
  .socials { display: flex; gap: 8px; flex-wrap: wrap; margin: 16px 0 0; }
  .socials a { width: 38px; height: 38px; border: 1px solid var(--line); border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; color: var(--muted); background: #fff; }
  .socials a:hover { color: var(--teal); border-color: var(--teal); }
</style>
